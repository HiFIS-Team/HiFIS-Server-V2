# 복사해서 사용:  cp .env.example .env  (실제 .env 는 커밋 금지 · 권한 600)

# App
ENVIRONMENT=development
DEBUG=true

# PostgreSQL — postgres 이미지가 읽는 값 + 앱 DATABASE_URL (셋을 일치시킬 것)
POSTGRES_USER=hifis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hifis
DATABASE_URL=postgresql+asyncpg://hifis:change-me@db:5432/hifis

# Redis
REDIS_URL=redis://redis:6379/0

# 보안 — 긴 랜덤 문자열로 교체 (예: openssl rand -hex 32)
JWT_SECRET=change-me-generate-a-long-random-string
# 업로드 파일 서명 URL 전용 키(선택). 비워 두면 JWT_SECRET 에서 파생한다.
# 채워 두면 JWT 시크릿을 갈아도 기존 파일 링크가 살아남는다. openssl rand -hex 32
FILE_SIGNING_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# 외부 웹훅 시크릿 (회원 친절도 설문 — 외부 폼에서 X-Webhook-Secret 헤더로 전송)
KINDNESS_WEBHOOK_SECRET=change-me-webhook-secret

# 계정관리 비번 암호화 마스터 키 — 64 hex(32 byte). 생성: openssl rand -hex 32
ACCOUNT_MASTER_KEY=change-me-64-hex-chars-openssl-rand-hex-32

# 초기 부트스트랩 시드 (docker compose exec api python -m app.seed)
SEED_BRANCH_NAME=전체
SEED_ADMIN_NAME=관리자
SEED_ADMIN_EMAIL=admin@hifis.local
SEED_ADMIN_PASSWORD=admin1234

# 대표 전용 잠금 — 켜면 MASTER 가 아닌 사람은 로그인도, 켜 둔 앱도 전부 503.
# 사고 대응용 임시 스위치라 평소엔 비워 둔다(=false).
# 바꾼 뒤 컨테이너를 다시 띄워야 먹는다 (.env 는 뜰 때 한 번만 읽는다).
#   docker compose -f docker-compose.prod.yml up -d --force-recreate api
# 지점 출퇴근 단말(X-Terminal-Token)은 이 잠금에 안 걸린다 — 출퇴근은 계속 찍힌다.
MASTER_ONLY=false

# 이메일 발송 (비밀번호 재설정 인증번호) — 비우면 코드가 서버 로그로만 나옴(개발).
# 무료 SMTP 하나면 충분. 예) Naver: smtp.naver.com / Gmail: smtp.gmail.com (앱 비밀번호 사용).
# SMTP_HOST=smtp.naver.com
# SMTP_PORT=587
# SMTP_USER=your-account@naver.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=your-account@naver.com
# SMTP_STARTTLS=true

# 문자(SMS) 발송 — 솔라피. 셋이 다 있어야 실제로 나가고, 비면 코드가 서버 로그로만 나옴.
# HiFIS v1 에서 쓰던 값 그대로 넣으면 된다 (같은 계정·같은 발신번호).
# SOLAPI_SENDER 는 솔라피 콘솔에 **사전등록·인증이 끝난 번호**여야 한다 — 아니면 발송이 거부된다.
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=
# SOLAPI_SENDER=
#
# ⚠️ 문자는 이 셋만으로는 안 나간다. **발신번호가 지점마다 따로다**
#    (`branches.sms_sender` — DB 행이라 배포로는 절대 안 따라간다).
#    비어 있으면 SOLAPI_SENDER 로 대신 보내지 않고 **아예 안 보낸다** —
#    화순 회원이 첨단으로 되거는 일을 막으려는 것이다.

# 컴플레인 한 줄 요약 (Claude Messages API)
#
# 매장 TV 는 컴플레인을 **두 줄까지만** 그리고 자른다. 회원이 길게 적으면
# 벽에 `...` 로 끊긴 문장이 걸려서, 해결 완료로 넘어갈 때 한 줄로 줄여
# `kindness_surveys.summary` 에 박아 둔다.
#
# **비면 조용히 넘어간다** — 해결 처리는 그대로 끝나고 TV 에 원문이 걸린다.
# 그래서 안 넣어도 아무 표시가 안 난다 (2026-09-08 ~ 09-15 실제로 그랬다).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# 서버 내부 훅 토큰 — 서버의 PAM 훅이 `POST /security/ssh-login` 을 부를 때 쓴다.
# 비우면 그 엔드포인트가 항상 401 이라 SSH 접속 알림이 안 간다.  생성: openssl rand -hex 32
INTERNAL_HOOK_TOKEN=

# CORS — 허용할 프론트 오리진 (콤마 구분)
CORS_ORIGINS=http://localhost:3000

# 배포용 Caddy 도메인 (미설정 시 localhost). 새 서브도메인 사용.
# DOMAIN=hifis-api.example.com
