# 복사해서 사용:  cp .env.example .env  (실제 .env 는 커밋 금지 · 권한 600)

# App
ENVIRONMENT=development
DEBUG=true

# PostgreSQL — postgres 이미지가 읽는 값 + 앱 DATABASE_URL (셋을 일치시킬 것)
POSTGRES_USER=hifis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hifis
DATABASE_URL=postgresql+asyncpg://hifis:change-me@db:5432/hifis

# Redis
REDIS_URL=redis://redis:6379/0

# 보안 — 긴 랜덤 문자열로 교체 (예: openssl rand -hex 32)
JWT_SECRET=change-me-generate-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# 외부 웹훅 시크릿 (회원 친절도 설문 — 외부 폼에서 X-Webhook-Secret 헤더로 전송)
KINDNESS_WEBHOOK_SECRET=change-me-webhook-secret

# 계정관리 비번 암호화 마스터 키 — 64 hex(32 byte). 생성: openssl rand -hex 32
ACCOUNT_MASTER_KEY=change-me-64-hex-chars-openssl-rand-hex-32

# 초기 부트스트랩 시드 (docker compose exec api python -m app.seed)
SEED_BRANCH_NAME=전체
SEED_ADMIN_NAME=관리자
SEED_ADMIN_EMAIL=admin@hifis.local
SEED_ADMIN_PASSWORD=admin1234

# 이메일 발송 (비밀번호 재설정 인증번호) — 비우면 코드가 서버 로그로만 나옴(개발).
# 무료 SMTP 하나면 충분. 예) Naver: smtp.naver.com / Gmail: smtp.gmail.com (앱 비밀번호 사용).
# SMTP_HOST=smtp.naver.com
# SMTP_PORT=587
# SMTP_USER=your-account@naver.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=your-account@naver.com
# SMTP_STARTTLS=true

# 문자(SMS) 발송 — 솔라피. 셋이 다 있어야 실제로 나가고, 비면 코드가 서버 로그로만 나옴.
# HiFIS v1 에서 쓰던 값 그대로 넣으면 된다 (같은 계정·같은 발신번호).
# SOLAPI_SENDER 는 솔라피 콘솔에 **사전등록·인증이 끝난 번호**여야 한다 — 아니면 발송이 거부된다.
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=
# SOLAPI_SENDER=

# 서버 내부 훅 토큰 — 서버의 PAM 훅이 `POST /security/ssh-login` 을 부를 때 쓴다.
# 비우면 그 엔드포인트가 항상 401 이라 SSH 접속 알림이 안 간다.  생성: openssl rand -hex 32
INTERNAL_HOOK_TOKEN=

# CORS — 허용할 프론트 오리진 (콤마 구분)
CORS_ORIGINS=http://localhost:3000

# 배포용 Caddy 도메인 (미설정 시 localhost). 새 서브도메인 사용.
# DOMAIN=hifis-api.example.com
